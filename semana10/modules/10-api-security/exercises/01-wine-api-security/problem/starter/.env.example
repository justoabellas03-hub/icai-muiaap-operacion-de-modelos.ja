# Configuración de la Wine Quality API (S10).
# Copia este archivo a `.env` y sustituye cada clave de ejemplo por una
# aleatoria, por ejemplo con:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# `.env` está en .gitignore: nunca lo subas al repositorio.

# Predictor: `ready` o `unavailable` (simula un modelo no cargado).
WINE_API_MODE=ready

# Clientes autorizados, en JSON: nombre -> {key, scopes, rate_limit_per_minute}.
# - `front` (Streamlit) solo puede predecir: scope `predict`.
# - `ops` además consulta el consumo en `GET /v1/admin/usage`: scope `admin`.
# - `rate_limit_per_minute` es la cuota por minuto (entero > 0; 60 si se omite).
# pydantic-settings decodifica como JSON los campos `dict` y `list`. El JSON va
# entre comillas simples para que el parser de `.env` conserve las comillas
# dobles y no interprete nada del contenido. Sin clientes, ninguna clave vale.
# Las claves `cambia-...` son de EJEMPLO: genera las tuyas en `.env`.
WINE_API_CLIENTS='{"front": {"key": "cambia-esta-clave-front", "scopes": ["predict"], "rate_limit_per_minute": 60}, "ops": {"key": "cambia-esta-clave-ops", "scopes": ["predict", "admin"], "rate_limit_per_minute": 120}}'

# Orígenes que pueden leer la API desde un navegador (CORS), en JSON.
# Se listan uno a uno: `"*"` se rechaza al arrancar.
WINE_API_CORS_ORIGINS='["http://localhost:8501"]'

# `true` publica /docs, /redoc y /openapi.json; `false` los oculta (404).
# Ocultarlos reduce lo que se anuncia, pero no protege: la seguridad es la clave.
WINE_API_DOCS_ENABLED=true
